{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-codex-dev/types/**/*.ts",
    ".next-codex-dev/dev/types/**/*.ts",
    ".next-release-safe-20261012/types/**/*.ts",
    ".next-release-safe-20261012/dev/types/**/*.ts",
    ".next-codex-start-20261012/types/**/*.ts",
    ".next-codex-start-20261012/dev/types/**/*.ts",
    ".next-codex-start2-20261012/types/**/*.ts",
    ".next-codex-start2-20261012/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
