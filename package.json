{
  "name": "subsc-list",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "node scripts/prisma-generate.cjs && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run test:engagement",
    "prisma:generate": "node scripts/prisma-generate.cjs",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:migrate": "prisma migrate dev",
    "test:usage": "node --experimental-strip-types --test src/lib/subscription-usage.test.ts",
    "test:engagement": "node --experimental-strip-types --test src/lib/subscription-usage.test.ts src/lib/subscription-cost.test.ts src/lib/subscription-health.test.ts src/lib/subscription-unused.test.ts src/lib/subscription-duplicates.test.ts src/lib/subscription-cancellation-candidates.test.ts src/lib/subscription-weekly-review.test.ts src/lib/notification-schedule.test.ts src/lib/engagement-notifications.test.ts src/lib/calendar-date.test.ts src/lib/contact-guard.test.ts src/lib/auth-rate-limit.test.ts",
    "format": "prettier --write .",
    "seed:demo": "node scripts/seed-demo-production.cjs",
    "seed:admin": "node scripts/seed-admin.cjs"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@types/nodemailer": "^8.0.1",
    "bcryptjs": "^3.0.3",
    "mariadb": "^3.5.3",
    "next": "16.3.3",
    "nodemailer": "^9.0.6",
    "prettier": "^3.9.6",
    "prisma": "^7.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "^22.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
